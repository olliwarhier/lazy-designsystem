  "mode": {
    "$type": "string",
    "$value": "Desktop",
    "$extensions": {
      "lazy": {
        "figma": "Mode",
        "modes": {
          "Mobile": "Mobile"
        }
      }
    }
  },
  "breakpoint": {
    "$type": "number",
    "$value": 1440,
