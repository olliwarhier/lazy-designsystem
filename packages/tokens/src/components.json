    "gap": {
      "$type": "number",
      "$value": "{spacing.dynamic.2xsmall}",
      "$extensions": {
        "lazy": {
          "figma": "Button/Gap",
          "modes": {
            "Large": "{spacing.dynamic.xsmall}",
            "Small": "{spacing.static.3xsmall}"
          }
        }
      }
